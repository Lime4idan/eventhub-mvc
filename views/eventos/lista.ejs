<%- include('../partials/header') %>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div><h1 class="h2 mb-1"><%= usuario.tipo === 'organizador' ? 'Meus eventos' : 'Próximos eventos' %></h1><p class="text-secondary mb-0">Consulte os eventos cadastrados.</p></div>
  <% if (usuario.tipo === 'organizador') { %><a class="btn btn-primary" href="/eventos/novo">+ Criar evento</a><% } %>
</div>
<section class="grade">
  <% if (!eventos.length) { %><div class="card border-0 shadow-sm p-4"><p class="text-secondary mb-0">Nenhum evento encontrado.</p></div><% } %>
  <% eventos.forEach(evento => { %>
    <article class="card shadow-sm cartao">
      <span class="badge data-evento"><%= new Date(evento.data_evento).toLocaleDateString('pt-BR') %></span>
      <h2 class="h5"><%= evento.titulo %></h2>
      <p><strong>Local:</strong> <%= evento.local %></p>
      <p><strong>Inscritos:</strong> <%= evento.total_inscritos %> / <%= evento.vagas %></p>
      <div class="acoes">
        <a class="btn btn-sm btn-outline-primary" href="/eventos/<%= evento.id %>">Detalhes</a>
        <% if (usuario.tipo === 'organizador') { %>
          <a class="btn btn-sm btn-outline-primary" href="/eventos/<%= evento.id %>/editar">Editar</a>
          <a class="btn btn-sm btn-outline-primary" href="/eventos/<%= evento.id %>/inscritos">Inscritos</a>
          <form action="/eventos/<%= evento.id %>/excluir" method="post" onsubmit="return confirm('Excluir este evento?')"><button class="btn btn-sm btn-outline-danger">Excluir</button></form>
        <% } %>
      </div>
    </article>
  <% }) %>
</section>
<%- include('../partials/footer') %>
