<%- include('../partials/header') %>
<header class="page-heading compact-heading"><div><p class="eyebrow">Guest list</p><h1><%= evento.titulo %></h1><p>Everyone who reserved a place at this event.</p></div><a class="btn btn-outline-primary" href="/eventos">Back to events</a></header>
<section class="card roster-card"><div class="card-body p-4 p-md-5">
  <% if (!inscritos.length) { %><div class="empty-state inline-empty"><span aria-hidden="true">✦</span><h2>No attendees yet</h2><p>The guest list will update as people register.</p></div><% } else { %>
    <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Name</th><th>Email</th><th>Registered</th></tr></thead><tbody>
      <% inscritos.forEach(pessoa => { %><tr><td><%= pessoa.nome %></td><td><%= pessoa.email %></td><td><%= new Date(pessoa.data_inscricao).toLocaleString('en-US') %></td></tr><% }) %>
    </tbody></table></div>
  <% } %>
</div></section>
<%- include('../partials/footer') %>
