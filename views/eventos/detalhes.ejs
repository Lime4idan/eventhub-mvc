<%- include('../partials/header') %>
<article class="card border-0 shadow-sm detalhes-evento mx-auto"><div class="card-body p-4 p-md-5">
  <span class="badge data-evento mb-3"><%= new Date(evento.data_evento).toLocaleString('pt-BR') %></span>
  <h1 class="h2"><%= evento.titulo %></h1>
  <p class="descricao text-secondary"><%= evento.descricao %></p>
  <dl class="informacoes-evento"><dt>Local</dt><dd><%= evento.local %></dd><dt>Organizador</dt><dd><%= evento.organizador_nome %></dd><dt>Vagas disponíveis</dt><dd><%= evento.vagas_disponiveis %> de <%= evento.vagas %></dd></dl>
  <div class="acoes">
    <% if (usuario.tipo === 'participante' && !inscrito && evento.vagas_disponiveis > 0) { %><form action="/eventos/<%= evento.id %>/inscrever" method="post"><button class="btn btn-primary">Inscrever-se</button></form><% } %>
    <% if (usuario.tipo === 'participante' && inscrito) { %><form action="/eventos/<%= evento.id %>/cancelar" method="post"><button class="btn btn-outline-danger">Cancelar inscrição</button></form><% } %>
    <a class="btn btn-light border" href="/eventos">Voltar</a>
  </div>
</div></article>
<%- include('../partials/footer') %>
