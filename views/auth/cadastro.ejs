<%- include('../partials/header') %>
<section class="auth-layout">
  <aside class="auth-showcase auth-showcase-register">
    <div>
      <p class="eyebrow">Your next gathering starts here</p>
      <h1>Bring good people together.</h1>
      <p>Join as an attendee to discover new experiences, or create an organizer account and turn your own idea into an event.</p>
    </div>
    <div class="role-notes">
      <p><strong>Attendee</strong><span>Browse events and reserve a spot.</span></p>
      <p><strong>Organizer</strong><span>Create events and manage registrations.</span></p>
    </div>
  </aside>
  <div class="auth-panel">
    <section class="card card-form"><div class="card-body p-0">
      <p class="eyebrow">Create your profile</p>
      <h2>Join EventHub</h2>
      <p class="text-secondary mb-4">A few details are all you need to get started.</p>
      <%- include('../partials/erros', { erros }) %>
      <form action="/cadastro" method="post">
        <div class="mb-3"><label class="form-label" for="nome">Name</label><input class="form-control" id="nome" name="nome" autocomplete="name" value="<%= dados.nome || '' %>" required></div>
        <div class="mb-3"><label class="form-label" for="email">Email</label><input class="form-control" id="email" name="email" type="email" autocomplete="email" value="<%= dados.email || '' %>" required></div>
        <div class="mb-3"><label class="form-label" for="senha">Password</label><input class="form-control" id="senha" name="senha" type="password" autocomplete="new-password" minlength="6" required><div class="form-text">Use at least 6 characters.</div></div>
        <div class="mb-4"><label class="form-label" for="tipo">I want to join as</label><select class="form-select" id="tipo" name="tipo" required>
          <option value="participante" <%= dados.tipo === 'participante' ? 'selected' : '' %>>Attendee</option>
          <option value="organizador" <%= dados.tipo === 'organizador' ? 'selected' : '' %>>Organizer</option>
        </select></div>
        <button class="btn btn-primary w-100" type="submit">Create account</button>
      </form>
      <p class="text-center mt-4 mb-0">Already have an account? <a href="/login">Sign in</a>.</p>
    </div></section>
  </div>
</section>
<%- include('../partials/footer') %>
